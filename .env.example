# Mapled: project settings (the gear in the project's header) → Integrations → Your site.
# The delivery key reads published content only.
MAPLED_KEY=

# The signing secret Mapled shows once when you save the revalidation webhook
# (https://your-site.com/api/mapled/revalidate). Until it is set, the webhook route answers 503.
MAPLED_WEBHOOK_SECRET=
